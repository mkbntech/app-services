<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> — TrailHead Supply Co.</title>
  <script>
    (function() {
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = savedTheme || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fjalla+One&family=IBM+Plex+Mono:wght@500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">
    <div class="product-detail">
      <div class="product-media">
        <img src="<%= product.image %>" alt="<%= product.name %>" width="220" height="220">
      </div>
      <div class="product-info">
        <span class="card-category"><%= product.category %></span>
        <h1><%= product.name %></h1>
        <%- include('partials/blaze-rating', { rating: summary.averageRating, count: summary.count }) %>
        <p class="description"><%= product.description %></p>
        <div class="tag-row">
          <% (product.tags || []).forEach(function(t) { %><span class="tag">#<%= t %></span><% }) %>
        </div>
        <div class="price">$<%= product.price.toFixed(2) %></div>
        <br>
        <button class="btn" type="button">Add to pack (demo only)</button>
      </div>
    </div>

    <svg class="contour-divider" viewBox="0 0 1140 22" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,11 C 100,20 200,2 300,11 S 500,20 600,11 S 800,2 900,11 S 1100,20 1140,11" style="stroke:var(--line); fill:none; stroke-width:1.4"/>
    </svg>

    <section>
      <span class="section-label">You might also carry</span>
      <h2 class="section-title">Recommended for the <%= product.category %> route</h2>
      <% if (recommendations.length === 0) { %>
        <p style="color:var(--ink-soft); padding-bottom:2rem;">No recommendations available right now — the recommendation engine may be warming up.</p>
      <% } else { %>
        <div class="rec-row">
          <% recommendations.forEach(function(r) { %>
            <a class="card" href="/products/<%= r.product.id %>">
              <div class="card-media"><img src="<%= r.product.image %>" alt="<%= r.product.name %>" width="70" height="70"></div>
              <div class="card-body">
                <span class="card-category"><%= r.product.category %></span>
                <h3 class="card-title"><%= r.product.name %></h3>
                <div class="card-footer">
                  <span class="price">$<%= r.product.price.toFixed(2) %></span>
                </div>
              </div>
              <div class="rec-reason"><%= r.reason %></div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="reviews-section" id="reviews">
      <span class="section-label">Field reports</span>
      <h2 class="section-title">Reviews &amp; trail blazes</h2>

      <% if (typeof formError !== 'undefined' && formError) { %>
        <div class="form-error">Couldn't submit your review — the review service may be unreachable. Please try again.</div>
      <% } %>

      <div class="review-summary">
        <span class="avg"><%= summary.averageRating ? summary.averageRating.toFixed(1) : '—' %></span>
        <%- include('partials/blaze-rating', { rating: summary.averageRating, count: summary.count }) %>
      </div>

      <% if (reviews.length === 0) { %>
        <p style="color:var(--ink-soft);">No reports yet. Be the first to blaze this trail.</p>
      <% } else { %>
        <% reviews.forEach(function(r) { %>
          <div class="review-card">
            <span class="author"><%= r.author %></span>
            <span class="meta"><%= new Date(r.createdAt).toLocaleDateString() %></span>
            <%- include('partials/blaze-rating', { rating: r.rating }) %>
            <p><%= r.comment %></p>
          </div>
        <% }) %>
      <% } %>

      <form class="review-form" method="POST" action="/products/<%= product.id %>/reviews">
        <div>
          <label for="author">Trail name</label>
          <input type="text" id="author" name="author" placeholder="e.g. ridge_runner" required>
        </div>
        <div>
          <label for="rating">Blazes (1&ndash;5)</label>
          <select id="rating" name="rating" required>
            <option value="5">5 — Send it again</option>
            <option value="4">4 — Solid</option>
            <option value="3">3 — Fine</option>
            <option value="2">2 — Rough</option>
            <option value="1">1 — Left it at basecamp</option>
          </select>
        </div>
        <div>
          <label for="comment">Field notes</label>
          <textarea id="comment" name="comment" rows="3" placeholder="How did it hold up on the trail?"></textarea>
        </div>
        <button class="btn" type="submit">Post field report</button>
      </form>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
